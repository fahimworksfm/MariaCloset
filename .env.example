# Copy to .env.local and fill in. None are required to run the public site.

# Password for the /admin dashboard. CHANGE THIS before sharing the app.
ADMIN_PASSWORD=mariacloset

# Optional — powers AI search, the AI stylist and "Auto-fill from photo".
# Get a key at https://console.groq.com. The admin home shows whether it works.
GROQ_API_KEY=
# Best left UNSET so the built-in defaults are used (they're kept current).
# Override only if needed — the admin status line flags a retired model.
# Vision model for photo auto-fill (default: qwen/qwen3.8-27b; Llama 4 Scout
# was retired by Groq on 17 Jul 2026). Must accept image input.
GROQ_VISION_MODEL=
# Text model for search + stylist (default: llama-3.3-70b-versatile).
GROQ_MODEL=

# Database + media: Supabase (added via Vercel → Storage → Supabase).
# Don't fill these by hand — run `vercel env pull .env.local`.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only for `npm run db:seed` importing the old Vercel Blob data (optional).
BLOB_READ_WRITE_TOKEN=

# Optional — email notifications (new request → owner, approve/decline → renter).
# Get a key at https://resend.com. Without it, notifications are simply skipped.
RESEND_API_KEY=
# Verified sender (or leave default for Resend test mode, which only delivers to
# your own Resend account email).
RESEND_FROM="Maria's Closet <onboarding@resend.dev>"
# Fallback for new-request emails if no owner email is set in admin → Settings.
OWNER_EMAIL=

# Note: "Remove background" in the admin runs free in the browser
# (@imgly/background-removal) — no API key needed.
